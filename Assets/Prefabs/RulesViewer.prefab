      m_Calls: []
  m_text: "\u2022 <b>There is a TIE</b>. Follow <link=\"loose_ball\"><color=#79CEF2><u>Loose
    Ball</u></color></link> instructions, players involved in the Aerial challenge
    cannot stop the ball. If the ball lands on a player that jumped, move it one
    Hex further away. If the Ball hits a player that has not jumped, continue play
    as \"Any other Scenario\". If the ball does not hit a player, check if it stopped
    in a defender's ZOI, and possibly attempt to gain it. If not, attacking team
    should start a <link=\"movement_phase\"><color=#79CEF2><u>Movement Phase</u></color></link>."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: c5fdfdb697f0641feb89600dc51bf367, type: 2}
