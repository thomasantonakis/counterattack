      m_Calls: []
  m_text: "\u2022 <b>Defence wins</b>. Play a headed pass from the ball, to the available
    distance, without interceptions along the airborne path. At its final hex the
    ball drops to the ground; eligible defenders whose ZOI covers that hex may attempt
    an interception. Players who jumped or are otherwise ineligible cannot attempt
    it. Beware of the pass back to the GK. If the GK won a legal own-box catch, attract
    the ball and continue as <link=\"goalkeeper\"><color=#79CEF2><u>Save and Hold</u></color></link>;
    a GK winning outside their own box instead heads the ball away with the ordinary
    headed-pass continuation."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: c5fdfdb697f0641feb89600dc51bf367, type: 2}
  m_sharedMaterial: {fileID: -3696773024713006346, guid: c5fdfdb697f0641feb89600dc51bf367, type: 2}
