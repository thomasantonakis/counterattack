  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2022 Attacking <link=\"movement_phase\"><color=#79CEF2><u>Movement Phase</u></color></link>,
    if an attacker attempts to dribble the ball around, you can try to dive at their
    feet (but you can choose not to). You can dive 3 hexes in either direction, parallel
    to the goal line. Diving at feet on the 3rd Hex away has a -1 dice penalty. The
    GK has the ability to \"dive at feet\" anytime a player is within a saving hex,
    even if a snapshot is about to be called on said saving hex"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: c5fdfdb697f0641feb89600dc51bf367, type: 2}
