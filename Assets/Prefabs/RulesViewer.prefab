  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name:
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'When the game is played using 12-sided dice, the Jackpot Roll is in effect.
    A STAR automatically wins an eligible duel. If both opponents roll a STAR, the
    duel is a tie regardless of their attributes and is resolved with a loose ball.
    In this digital edition, a STAR also automatically succeeds on High Pass accuracy
    (including goalkeeper kicks and corners), Long Pass accuracy and Ball Control,
    regardless of attributes or distance penalties. Rolls that do not accept jackpots
    treat a STAR as a 6. Attribute-based totals use max(current attribute + all signed
    modifiers, 0) + dice: apply injuries and applicable modifiers before flooring
    the effective attribute at zero, then add the numeric roll. Eligible jackpots
    total 50 without attributes or penalties; natural-one misses and fouls retain
    their normal rules.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: c5fdfdb697f0641feb89600dc51bf367, type: 2}
  m_sharedMaterial: {fileID: -3696773024713006346, guid: c5fdfdb697f0641feb89600dc51bf367, type: 2}
