  m_text: "\u2022 If you roll equal to or higher than the goalkeeper's Handling,
    run a <link=\"loose_ball\"><color=#79CEF2><u>Loose Ball</u></color></link> test.
    If the direction is behind or to the side of the GK a Corner Kick has been conceded.
    If the direction is in front of the GK, roll for distance too and play contines
    with the <link=\"loose_ball\"><color=#79CEF2><u>Loose Ball</u></color></link>
    process."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: c5fdfdb697f0641feb89600dc51bf367, type: 2}
