  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'After the Accuracy Check the GK has the option to move 3 Hexes, but only
    if they commit to challenge for the high ball and have <b>not already</b> used
    the regular 3-hex defensive high-pass move. The keeper''s final position, not
    the ball''s hex, determines the attribute: a defending keeper inside their own
    penalty area uses Aerial Ability to catch; outside it they use Heading 0 and
    must head the ball away on a win. The goalkeeper always retains a separate nomination
    alongside up to two outfield players, even outside their box. A zero heading
    attribute receives no further distance penalty. The keeper may start or finish
    a rush outside their own box; this never authorizes handling there.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: c5fdfdb697f0641feb89600dc51bf367, type: 2}
  m_sharedMaterial: {fileID: -3696773024713006346, guid: c5fdfdb697f0641feb89600dc51bf367, type: 2}
